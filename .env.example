# Copy to .env and fill in the blanks. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/movie_memory?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI
OPENAI_API_KEY=""
# Optional, defaults to gpt-4o-mini
OPENAI_MODEL="gpt-4o-mini"
